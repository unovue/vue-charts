    "axe-core": "^4.10.3",
    "bumpp": "^10.0.3",
    "changelogen": "^0.6.2",
    "d3": "^7.8.5",
    "esbuild": "^0.28.2",
    "eslint": "9.9.1",
    "eslint-plugin-import-x": "4.1.0",
    "jsdom": "^25.0.0",
    "knip": "^6.39.0",
    "lint-staged": "^15.5.0",
    "madge": "^8.0.0",
    "publint": "^0.3.25",
    "simple-git-hooks": "^2.12.1",
    "size-limit": "^11.2.0",
    "storybook": "^10.2.19",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
