{
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "outDir": "./dist/es",
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "files": [
    "./src/test/events-contract.ts"
  ],
  "include": [
    "./src/**/*.vue",
    "./src/**/*.ts",
    "./src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "src/**/__tests__/**",
    "src/test/*.ts",
    "src/**/__stories__/**",
    "src/storybook/**",
    "src/**/*.stories.*",
    "src/**/*.story.*"
  ]
}
