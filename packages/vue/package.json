{
  "name": "vccs",
  "type": "module",
  "version": "0.6.0",
  "description": "Composable charting components for Vue 3 — an unofficial port of Recharts",
  "author": "rick-hup",
  "license": "MIT",
  "homepage": "https://github.com/rick-hup/vuecharts#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rick-hup/vuecharts"
  },
  "bugs": {
    "url": "https://github.com/rick-hup/vuecharts/issues"
  },
  "keywords": [
    "charts",
    "vue",
    "vue3",
    "recharts",
    "composable",
    "typescript",
    "svg",
    "data-visualization",
    "charting"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/es/index.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/es/nuxt.mjs"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/es/resolver.mjs"
    }
  },
  "module": "./dist/es/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "./LICENSE",
    "./README.md",
    "./dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "bumpp": "bumpp package.json",
    "pub:release": "pnpm publish --access public",
    "size": "size-limit",
    "test:nuxt": "vitest run --config vitest.nuxt.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "typings": "./dist/index.d.ts",
  "peerDependencies": {
    "@nuxt/kit": "^3.15.0 || ^4.0.0",
    "motion-v": "^2.4.0",
    "unplugin-vue-components": "^30.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "unplugin-vue-components": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-shape": "^3.1.7",
    "@vueuse/core": "^13.1.0",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "decimal.js-light": "^2.5.1",
    "es-toolkit": "^1.39.3",
    "motion-dom": "^13.3.0",
    "reselect": "^5.1.1"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.4.2",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^3.21.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time": "^3.0.4",
    "@vitejs/plugin-vue-jsx": "^5.0.0",
    "@vue/babel-plugin-jsx": "^1.1.1",
    "@vue/runtime-core": "^3.5.13",
    "nuxt": "^4.4.2",
    "unplugin-vue-components": "^30.0.0",
    "vue": "^3.5.13"
  },
  "size-limit": [
    {
      "name": "Area chart",
      "path": "dist/es/index.mjs",
      "import": "{ AreaChart, Area, XAxis, YAxis, CartesianGrid, Tooltip }",
      "gzip": true,
      "limit": "78.31 kB",
      "ignore": [
        "vue",
        "motion-v"
      ]
    },
    {
      "name": "Bar chart",
      "path": "dist/es/index.mjs",
      "import": "{ BarChart, Bar, XAxis, YAxis, Tooltip, Legend }",
      "gzip": true,
      "limit": "81.62 kB",
      "ignore": [
        "vue",
        "motion-v"
      ]
    },
    {
      "name": "Pie chart",
      "path": "dist/es/index.mjs",
      "import": "{ PieChart, Pie, Tooltip }",
      "gzip": true,
      "limit": "65.78 kB",
      "ignore": [
        "vue",
        "motion-v"
      ]
    }
  ]
}
